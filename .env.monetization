MONETIZATION_ENDPOINT=https://appmonetization.us-east-2.api.aws

# AWS Monetization app identity. Sandbox: the full experience, including checkout,
# with no real charges. Live: real customers, real charges. To switch, swap which
# line is commented and redeploy the backend (the stack reads this file at synth).
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-east-2:136311627418:apps/01a189cdd193741d8521fd6fe16a28b0/sandbox
MONETIZATION_APP_ID=arn:aws:appmonetization:us-east-2:136311627418:apps/01a189cdd193741d8521fd6fe16a28b0
# Entitlement enforcement. 'false' keeps gated routes open while testing metering only.
MONETIZATION_ENFORCE=true

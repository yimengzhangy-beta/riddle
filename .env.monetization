MONETIZATION_ENDPOINT=https://us-west-2.alpha.monetization.aws.dev
MONETIZATION_REGION=us-west-2

# App identity. Sandbox: test the full experience, including checkout, with no real
# charges. Live: real customers, real charges. To switch, swap which line is
# commented and redeploy (or run `/monetize live`).
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:app/e92e5858-8c15-4600-9b97-31c801f9eb7d/sandbox
MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:app/e92e5858-8c15-4600-9b97-31c801f9eb7d

# Entitlement enforcement. 'false' skips the gate (every route stays open while
# you test metering); unset or any other value enforces. Note: with enforcement
# on, an unsubscribed player is DENIED every gated action until they pick a plan.
MONETIZATION_ENFORCE=true

# AWS Monetization runtime config for Riddle (app "Riddle 0928").
# No secrets here — ids, an endpoint and a region — so this file IS committed:
# backend/lib/app-stack.ts reads it at synth time to set the Lambda's environment.
#
# Sandbox: test the full experience, including checkout, with no real charges.
# Live:    real customers, real charges (plans must be published first).
# To switch, swap which MONETIZATION_APP_ID line is commented and redeploy,
# or run `/monetize live` / `/monetize sandbox`.
MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:app/4204a937-782b-4cd1-a303-5de1417b3a5e/sandbox
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:app/4204a937-782b-4cd1-a303-5de1417b3a5e

# Control plane, resolved from the SDK's own config. Not the app's AWS_REGION.
MONETIZATION_ENDPOINT=https://us-west-2.alpha.monetization.aws.dev
MONETIZATION_REGION=us-west-2

# Entitlement enforcement. 'false' keeps every billable route open while you
# verify metering; unset or any other value enforces (an unsubscribed player is
# denied until they pick a plan on the hosted pricing page).
MONETIZATION_ENFORCE=true

MONETIZATION_ENDPOINT=https://us-west-2.alpha.monetization.aws.dev
MONETIZATION_REGION=us-west-2
# App identity (AWS Monetization app "Riddle 0930"). Ids only — no secrets — so this
# file is committed; the CDK stack reads it at synth time.
# Sandbox: test the full experience, including checkout, with no real charges.
# Live: real customers, real charges. To switch, swap which line is commented and redeploy.
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:app/5eb16416-a4dc-430c-8c3e-e7073e930cac/sandbox
MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:app/5eb16416-a4dc-430c-8c3e-e7073e930cac
# Entitlement enforcement. 'false' keeps every route open while testing metering only;
# unset or any other value enforces (an unsubscribed player is denied every gated action).
MONETIZATION_ENFORCE=true

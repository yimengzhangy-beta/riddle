MONETIZATION_ENDPOINT=https://us-west-2.alpha.monetization.aws.dev
MONETIZATION_REGION=us-west-2
# Sandbox: test the full experience, including checkout, with no real charges.
# Live: real customers, real charges. To switch, swap which line is commented and redeploy.
MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:apps/db2a25fa-668b-49f9-833d-bed57f65aedd/sandbox
# MONETIZATION_APP_ID=arn:aws:appmonetization:us-west-2:136311627418:apps/db2a25fa-668b-49f9-833d-bed57f65aedd
# Entitlement enforcement. 'false' skips the gate while testing metering; unset or any other value enforces.
MONETIZATION_ENFORCE=true
